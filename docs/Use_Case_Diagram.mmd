flowchart LR
    %% Actors
    User(["Interactive User"]):::actor
    Kernel(["Linux Kernel / OS<br/>(POSIX Services)"]):::actor

    %% System Boundary
    subgraph Shell ["System Boundary: Simple Shell"]
        direction LR

        subgraph Session ["1. Session & Input Layer"]
            direction TB
            UC_Enter(["Enter Command Line"]):::primaryUC
            UC_Parse(["Parse Input & Tokens"]):::supportUC
            UC_Exit(["Exit Shell Session"]):::primaryUC
        end

        subgraph Execution ["2. Command Execution"]
            direction TB
            UC_External(["Execute External Program"]):::execUC
            UC_Builtin(["Execute Built-in Command<br/>(cd, pwd, echo, help)"]):::execUC
        end

        subgraph Modifiers ["3. Execution Modifiers & Diagnostics"]
            direction TB
            UC_Redir(["Redirect I/O<br/>(<, >, >>)"]):::modUC
            UC_Pipe(["Execute Pipeline<br/>(|)"]):::modUC
            UC_Bg(["Run in Background<br/>(&)"]):::modUC
            UC_Error(["Report Diagnostics<br/>& Syntax Errors"]):::errorUC
        end
    end

    %% User Interactions
    User --> UC_Enter
    User --> UC_Exit

    %% Core Parsing Inclusion
    UC_Enter -.->|&laquo;include&raquo;| UC_Parse

    %% Command Execution Routing
    UC_Enter --> UC_External
    UC_Enter --> UC_Builtin

    %% Execution Modifiers extend External Program
    UC_External <-.-|&laquo;extend&raquo;| UC_Redir
    UC_External <-.-|&laquo;extend&raquo;| UC_Pipe
    UC_External <-.-|&laquo;extend&raquo;| UC_Bg
    UC_External <-.-|&laquo;extend&raquo;| UC_Error

    %% POSIX Kernel Syscall Interfaces
    UC_External -->|fork, execvp, waitpid| Kernel
    UC_Builtin -->|chdir, getcwd| Kernel
    UC_Redir -->|open, dup2| Kernel
    UC_Pipe -->|pipe, dup2| Kernel
    UC_Bg -->|waitpid WNOHANG| Kernel

    %% Visual Styling
    classDef actor fill:#f8fafc,stroke:#0f172a,stroke-width:2px,font-weight:bold,color:#0f172a;
    classDef primaryUC fill:#ecfdf5,stroke:#059669,stroke-width:2px,font-weight:600,color:#064e3b;
    classDef execUC fill:#e0f2fe,stroke:#0284c7,stroke-width:2px,font-weight:600,color:#0c4a6e;
    classDef supportUC fill:#f1f5f9,stroke:#64748b,stroke-width:1.5px,stroke-dasharray: 4 2,color:#334155;
    classDef modUC fill:#fefce8,stroke:#d97706,stroke-width:1.5px,font-weight:500,color:#713f12;
    classDef errorUC fill:#fef2f2,stroke:#ef4444,stroke-width:1.5px,stroke-dasharray: 3 3,color:#7f1d1d;

    style Shell fill:#fafafa,stroke:#94a3b8,stroke-width:2px,stroke-dasharray: 5 5;
    style Session fill:#ffffff,stroke:#e2e8f0,stroke-width:1px;
    style Execution fill:#ffffff,stroke:#e2e8f0,stroke-width:1px;
    style Modifiers fill:#ffffff,stroke:#e2e8f0,stroke-width:1px;
